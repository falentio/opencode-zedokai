{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "cyan",
      "yellow",
      "green",
      "red"
    ],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$hue.neutral.400",
          "$focused": "$hue.neutral.800",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "$hue.neutral.800",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$hue.neutral.400",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.200"
        },
        "warning": {
          "base": "#f38d70"
        },
        "success": {
          "base": "$hue.green.200"
        },
        "info": {
          "base": "$hue.cyan.200"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.800",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.200"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#463f3f"
    },
    "scrollbar": {
      "base": "#72696a"
    },
    "diff": {
      "text": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200",
        "context": "$hue.neutral.400",
        "hunkHeader": "$hue.neutral.400"
      },
      "background": {
        "added": "#423b3b",
        "removed": "#423b3b",
        "context": "$hue.neutral.800"
      },
      "highlight": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200"
      },
      "lineNumber": {
        "text": "#5b5353",
        "background": {
          "added": "#423b3b",
          "removed": "#423b3b"
        }
      }
    },
    "syntax": {
      "comment": "#72696a",
      "keyword": "$hue.red.200",
      "function": "$hue.green.200",
      "variable": "$hue.neutral.200",
      "string": "$hue.interactive.200",
      "number": "#a8a9eb",
      "type": "$hue.cyan.200",
      "operator": "$hue.red.200",
      "punctuation": "$hue.neutral.400"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "$hue.red.200",
      "link": "$hue.green.200",
      "linkText": "$hue.red.200",
      "code": "$hue.interactive.200",
      "blockQuote": "#72696a",
      "emphasis": "#f38d70",
      "strong": "$hue.interactive.200",
      "horizontalRule": "$hue.neutral.400",
      "listItem": "$hue.green.200",
      "listEnumeration": "#a8a9eb",
      "image": "$hue.green.200",
      "imageText": "$hue.red.200",
      "codeBlock": "$hue.neutral.200"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#ffffff",
        "200": "#fff1f3",
        "300": "#c8bcbe",
        "400": "#948a8b",
        "500": "#695f60",
        "600": "#403838",
        "700": "#322b2b",
        "800": "#2c2525",
        "900": "#261f1f"
      },
      "red": {
        "100": "#f99aa6",
        "200": "#fd6883",
        "300": "#dd566f",
        "400": "#bd435b",
        "500": "#9e3249",
        "600": "#802136",
        "700": "#640f25",
        "800": "#450517",
        "900": "#28020a"
      },
      "orange": "$hue.gray",
      "yellow": {
        "100": "#fff2d7",
        "200": "#f9cc6c",
        "300": "#d6ad55",
        "400": "#b48f3f",
        "500": "#937329",
        "600": "#735712",
        "700": "#533e08",
        "800": "#342604",
        "900": "#181001"
      },
      "green": {
        "100": "#c9fa8f",
        "200": "#adda78",
        "300": "#92bb62",
        "400": "#789c4c",
        "500": "#5f7f37",
        "600": "#476222",
        "700": "#30470d",
        "800": "#1c2d02",
        "900": "#0b1501"
      },
      "cyan": {
        "100": "#9dfaeb",
        "200": "#85dacc",
        "300": "#6dbbae",
        "400": "#569c91",
        "500": "#407f75",
        "600": "#2a635a",
        "700": "#154841",
        "800": "#062e29",
        "900": "#011613"
      },
      "blue": "$hue.gray",
      "purple": "$hue.gray",
      "accent": "$hue.yellow",
      "interactive": "$hue.yellow",
      "neutral": "$hue.gray"
    }
  }
}
