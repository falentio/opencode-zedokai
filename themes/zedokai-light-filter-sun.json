{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "blue",
      "yellow",
      "green",
      "red"
    ],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$hue.neutral.400",
          "$focused": "$hue.neutral.800",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "$hue.neutral.800",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$hue.neutral.400",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "base": "#ce4770"
        },
        "warning": {
          "base": "$hue.red.200"
        },
        "success": {
          "base": "$hue.green.200"
        },
        "info": {
          "base": "$hue.blue.200"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.800",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "#ce4770"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#ccc5bf"
    },
    "scrollbar": {
      "base": "#a59c9c"
    },
    "diff": {
      "text": {
        "added": "$hue.green.200",
        "removed": "#ce4770",
        "context": "$hue.neutral.400",
        "hunkHeader": "$hue.neutral.400"
      },
      "background": {
        "added": "#eed8c4",
        "removed": "#eed8c4",
        "context": "$hue.neutral.800"
      },
      "highlight": {
        "added": "$hue.green.200",
        "removed": "#ce4770"
      },
      "lineNumber": {
        "text": "#beb5b3",
        "background": {
          "added": "#eed8c4",
          "removed": "#eed8c4"
        }
      }
    },
    "syntax": {
      "comment": "#a59c9c",
      "keyword": "#ce4770",
      "function": "$hue.green.200",
      "variable": "$hue.neutral.200",
      "string": "$hue.interactive.200",
      "number": "#6851a2",
      "type": "$hue.blue.200",
      "operator": "#ce4770",
      "punctuation": "$hue.neutral.400"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "#ce4770",
      "link": "$hue.green.200",
      "linkText": "#ce4770",
      "code": "$hue.interactive.200",
      "blockQuote": "#a59c9c",
      "emphasis": "$hue.red.200",
      "strong": "$hue.interactive.200",
      "horizontalRule": "$hue.neutral.400",
      "listItem": "$hue.green.200",
      "listEnumeration": "#6851a2",
      "image": "$hue.green.200",
      "imageText": "#ce4770",
      "codeBlock": "$hue.neutral.200"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
  "light": {
    "hue": {
      "gray": {
        "100": "#030109",
        "200": "#2c232e",
        "300": "#5e5359",
        "400": "#92898a",
        "500": "#b8aeac",
        "600": "#ded5d0",
        "700": "#ece5df",
        "800": "#f8efe7",
        "900": "#fffaf6"
      },
      "red": {
        "100": "#c74101",
        "200": "#d4572b",
        "300": "#e16c45",
        "400": "#ed805c",
        "500": "#fa9472",
        "600": "#faad95",
        "700": "#fec4b2",
        "800": "#fedcd0",
        "900": "#fef2ee"
      },
      "orange": "$hue.gray",
      "yellow": {
        "100": "#995b10",
        "200": "#b16803",
        "300": "#bf7a31",
        "400": "#ce8d4d",
        "500": "#dca066",
        "600": "#ebb37e",
        "700": "#f9c697",
        "800": "#fedcbe",
        "900": "#fff3e9"
      },
      "green": {
        "100": "#097661",
        "200": "#218871",
        "300": "#429982",
        "400": "#5ca994",
        "500": "#75baa6",
        "600": "#8dccb9",
        "700": "#a5ddcc",
        "800": "#bcefdf",
        "900": "#dbfef3"
      },
      "cyan": "$hue.gray",
      "blue": {
        "100": "#1061a0",
        "200": "#2473b6",
        "300": "#4186c5",
        "400": "#5a99d4",
        "500": "#72ace3",
        "600": "#8bbff2",
        "700": "#a7d2fc",
        "800": "#cbe4fd",
        "900": "#eef6ff"
      },
      "purple": "$hue.gray",
      "accent": "$hue.yellow",
      "interactive": "$hue.yellow",
      "neutral": "$hue.gray"
    }
  }
}
