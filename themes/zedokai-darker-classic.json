{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "cyan",
      "yellow",
      "green",
      "orange",
      "red"
    ],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$hue.neutral.400",
          "$focused": "$hue.neutral.800",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "$hue.neutral.800",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$hue.neutral.400",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.200"
        },
        "warning": {
          "base": "$hue.orange.200"
        },
        "success": {
          "base": "$hue.green.200"
        },
        "info": {
          "base": "$hue.cyan.200"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.800",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.200"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#131310"
    },
    "scrollbar": {
      "base": "#6e7066"
    },
    "diff": {
      "text": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200",
        "context": "$hue.neutral.400",
        "hunkHeader": "$hue.neutral.400"
      },
      "background": {
        "added": "#3d3e38",
        "removed": "#3d3e38",
        "context": "$hue.neutral.800"
      },
      "highlight": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200"
      },
      "lineNumber": {
        "text": "#57584f",
        "background": {
          "added": "#3d3e38",
          "removed": "#3d3e38"
        }
      }
    },
    "syntax": {
      "comment": "#6e7066",
      "keyword": "$hue.red.200",
      "function": "$hue.green.200",
      "variable": "$hue.neutral.200",
      "string": "$hue.interactive.200",
      "number": "#ae81ff",
      "type": "$hue.cyan.200",
      "operator": "$hue.red.200",
      "punctuation": "$hue.neutral.400"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "$hue.red.200",
      "link": "$hue.green.200",
      "linkText": "$hue.red.200",
      "code": "$hue.interactive.200",
      "blockQuote": "#6e7066",
      "emphasis": "$hue.orange.200",
      "strong": "$hue.interactive.200",
      "horizontalRule": "$hue.neutral.400",
      "listItem": "$hue.green.200",
      "listEnumeration": "#ae81ff",
      "image": "$hue.green.200",
      "imageText": "$hue.red.200",
      "codeBlock": "$hue.neutral.200"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#ffffff",
        "200": "#fdfff1",
        "300": "#c6c7bb",
        "400": "#919288",
        "500": "#64655d",
        "600": "#3b3c35",
        "700": "#20211c",
        "800": "#272822",
        "900": "#2e2f28"
      },
      "red": {
        "100": "#fd658b",
        "200": "#f92672",
        "300": "#da1461",
        "400": "#b51f53",
        "500": "#990e42",
        "600": "#790f34",
        "700": "#5b0b26",
        "800": "#410519",
        "900": "#29000c"
      },
      "orange": {
        "100": "#fcc08c",
        "200": "#fd971f",
        "300": "#db7f02",
        "400": "#b66c17",
        "500": "#925818",
        "600": "#754203",
        "700": "#562f01",
        "800": "#381e03",
        "900": "#1e0d00"
      },
      "yellow": {
        "100": "#fffbce",
        "200": "#e6db74",
        "300": "#c5ba5c",
        "400": "#a49b46",
        "500": "#857c2f",
        "600": "#675f18",
        "700": "#49440c",
        "800": "#2e2a01",
        "900": "#151200"
      },
      "green": {
        "100": "#ccfe83",
        "200": "#a6e22e",
        "300": "#8cc111",
        "400": "#75a11f",
        "500": "#5f811e",
        "600": "#466403",
        "700": "#33470c",
        "800": "#1e2d01",
        "900": "#0c1501"
      },
      "cyan": {
        "100": "#aff1ff",
        "200": "#66d9ef",
        "300": "#50bace",
        "400": "#3a9cad",
        "500": "#247e8e",
        "600": "#096270",
        "700": "#024751",
        "800": "#032d34",
        "900": "#021519"
      },
      "blue": "$hue.gray",
      "purple": "$hue.gray",
      "accent": "$hue.yellow",
      "interactive": "$hue.yellow",
      "neutral": "$hue.gray"
    }
  }
}
